# Credential-free template for the OPTIONAL Docker Compose stack.
# Copy to ".env" (git-ignored) and fill in the blank values locally. Never commit real values.
# Compose refuses to start while a required value is empty.
#
# Use simple passwords (letters and digits): they are embedded in a connection string.

# Administrative account of the Compose-managed PostgreSQL server (first-time provisioning only).
EVENTFORGE_POSTGRES_ADMIN_USER=postgres
EVENTFORGE_POSTGRES_ADMIN_PASSWORD=

# Passwords for the three EventForge roles created on first start (distinct values recommended).
EVENTFORGE_APP_PASSWORD=
EVENTFORGE_MIGRATOR_PASSWORD=
EVENTFORGE_OPERATOR_PASSWORD=

# Host ports (bound to 127.0.0.1 only).
EVENTFORGE_POSTGRES_PORT=5535
EVENTFORGE_API_PORT=8080
